# Copie para .env. A página inicial e os testes não precisam destas variáveis.
# MySQL 8.4 LTS: use um usuário próprio da aplicação, nunca root.
# Preencha com os valores reais fornecidos pelo administrador:
# mysql://USUARIO:SENHA_URL_ENCODED@HOST:3306/NOME_DO_BANCO
# Codifique caracteres especiais do usuário/senha para uso em URL.
DATABASE_URL=

# Gere localmente: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64"))'
# Nunca publique este segredo. Use no mínimo 32 caracteres aleatórios.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Não são necessárias variáveis individuais: o adapter recebe DATABASE_URL.
# Em produção, as duas URLs devem usar HTTPS e a mesma origem.
